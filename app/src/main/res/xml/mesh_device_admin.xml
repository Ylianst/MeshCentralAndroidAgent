<?xml version="1.0" encoding="utf-8"?>
<!-- Device Admin policy set. As Device Owner the agent gets these implicitly; declaring
     them keeps the receiver valid and lets the app use force-lock / wipe / etc. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
